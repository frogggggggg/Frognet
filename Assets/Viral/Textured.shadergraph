{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "ae9056fb84ff40609661bbe67c857f1f",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "_3dnoise (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -13.99997329711914,
            "y": -550.0,
            "width": 204.9999542236328,
            "height": 118.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "6b4bacd9398549efa14e7d88409cf75a"
        },
        {
            "m_Id": "b63d3dbd53d3470fbf840e2dc2d24a0d"
        },
        {
            "m_Id": "a98993bcbb884270a70a358782ad8c29"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "_3dnoise",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Apply scale to the world direction input\nfloat3 p = pos * scale;\n\n// 1. Skewing factors for 3D Simplex\nfloat F3 = 0.333333333;\nfloat G3 = 0.166666667;\n\nfloat3 s = floor(p + dot(p, (float3)F3));\nfloat3 x0 = p - s + dot(s, (float3)G3);\n\n// 2. Identify simplex simplex paths\nfloat3 e = step((float3)0.0, x0 - x0.yzx);\nfloat3 i1 = e * (1.0 - e.zxy);\nfloat3 i2 = 1.0 - e.zxy * (1.0 - e);\n\nfloat3 x1 = x0 - i1 + (float3)G3;\nfloat3 x2 = x0 - i2 + (float3)(2.0 * G3);\nfloat3 x3 = x0 - (float3)(1.0 - 3.0 * G3);\n\n// 3. High-frequency Sine/Cos Hash to completely wipe out circular grid alignment\nfloat4 w, d;\n\n// Corner 0\nfloat3 g0 = sin(float3(dot(s, float3(127.1, 311.7, 74.7)), \n                       dot(s, float3(269.5, 183.3, 246.1)), \n                       dot(s, float3(113.5, 271.9, 124.3)))) * 43758.5453;\ng0 = frac(g0) - 0.5;\n\n// Corner 1\nfloat3 s1 = s + i1;\nfloat3 g1 = sin(float3(dot(s1, float3(127.1, 311.7, 74.7)), \n                       dot(s1, float3(269.5, 183.3, 246.1)), \n                       dot(s1, float3(113.5, 271.9, 124.3)))) * 43758.5453;\ng1 = frac(g1) - 0.5;\n\n// Corner 2\nfloat3 s2 = s + i2;\nfloat3 g2 = sin(float3(dot(s2, float3(127.1, 311.7, 74.7)), \n                       dot(s2, float3(269.5, 183.3, 246.1)), \n                       dot(s2, float3(113.5, 271.9, 124.3)))) * 43758.5453;\ng2 = frac(g2) - 0.5;\n\n// Corner 3\nfloat3 s3 = s + 1.0;\nfloat3 g3 = sin(float3(dot(s3, float3(127.1, 311.7, 74.7)), \n                       dot(s3, float3(269.5, 183.3, 246.1)), \n                       dot(s3, float3(113.5, 271.9, 124.3)))) * 43758.5453;\ng3 = frac(g3) - 0.5;\n\n// 4. Kernels and blending weights\nw.x = dot(x0, x0);\nw.y = dot(x1, x1);\nw.z = dot(x2, x2);\nw.w = dot(x3, x3);\n\nw = max(0.6 - w, 0.0);\n\nd.x = dot(g0, x0);\nd.y = dot(g1, x1);\nd.z = dot(g2, x2);\nd.w = dot(g3, x3);\n\nw *= w;\nw *= w;\n\n// 5. Output cleanly isolated between 0.0 and 1.0\nnoise = saturate((dot(w, d) * 52.0) * 0.5 + 0.5);\n"
}

