{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "c40a68f7c73a43d3859c9fc7285b3f09",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "GaussianBlurSubShader (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -520.0000610351563,
            "y": 519.0000610351563,
            "width": 291.0000305175781,
            "height": 142.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "251011c4607b4156ae3844582f6ad2b6"
        },
        {
            "m_Id": "66ef9f1b26794289b8598891360a2262"
        },
        {
            "m_Id": "152cf03e075c405cae7d62dc529cace0"
        },
        {
            "m_Id": "8496665c014649d594e0112702756eb9"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GaussianBlurSubShader",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "$precision col = 0.0;\r\n$precision kernelSum = 0.0;\r\n\r\nint radius = (int)Blur;\r\n\r\nfor (int x = -radius; x <= radius; x++)\r\n{\r\n    for (int y = -radius; y <= radius; y++)\r\n    {\r\n        $precision2 offset =\r\n            Texture.texelSize.xy * $precision2(x, y);\r\n\r\n        $precision sampleValue =\r\n            SAMPLE_TEXTURE2D(\r\n                Texture.tex,\r\n                Texture.samplerstate,\r\n                UV + offset\r\n            ).r;\r\n\r\n        col += sampleValue;\r\n        kernelSum += 1.0;\r\n    }\r\n}\r\n\r\nOut = col / max(kernelSum, 1.0);\n"
}

