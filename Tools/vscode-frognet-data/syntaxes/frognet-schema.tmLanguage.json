{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Frognet Schema",
  "scopeName": "source.fschema",
  "patterns": [
    { "include": "#comment" },
    { "include": "#declaration" },
    { "include": "#bare" },
    { "include": "#bracket" }
  ],
  "repository": {
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.fschema"
    },
    "bracket": {
      "match": "[\\[\\]{}]",
      "name": "punctuation.section.block.fschema"
    },
    "type": {
      "match": "\\b(float|int|bool|string)\\b",
      "name": "support.type.primitive.fschema"
    },
    "reference": {
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
      "name": "entity.name.type.reference.fschema"
    },
    "declaration": {
      "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(=)(.*)$",
      "captures": {
        "1": { "name": "entity.name.tag.key.fschema" },
        "2": { "name": "keyword.operator.assignment.fschema" },
        "3": {
          "patterns": [
            { "include": "#comment" },
            { "include": "#bracket" },
            { "include": "#type" },
            { "include": "#reference" }
          ]
        }
      }
    },
    "bare": {
      "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=//|$)",
      "captures": {
        "1": { "name": "variable.other.enummember.fschema" }
      }
    }
  }
}
